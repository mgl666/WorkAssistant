[Unit]
Description=WorkAssistant API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/work-assistant/server
EnvironmentFile=/var/www/work-assistant/.env.server
ExecStart=/usr/bin/node /var/www/work-assistant/server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
